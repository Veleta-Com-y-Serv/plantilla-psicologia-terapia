---
// Primera cita: fila 50/50 a todo el ancho. Mitad salvia plena con titular enorme, `texto`, `items` (pasos
// numerados: {titulo, texto}), `cta` (WhatsApp o teléfono), `enlace_agenda` + `texto_agenda` (agenda online,
// opcional), teléfono de contacto y `nota`. Mitad salvia clara con el formulario (mailto): terapias de la sección
// `terapias` en el desplegable, modalidades sacadas de sus `modalidad` y franja horaria. `boton`: texto del botón.
import { seccion, seccionDeTipo, site, tel, cadena, enlace, externo } from '../../data/site';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const cta = enlace(s?.cta);
const agenda = cadena(s?.enlace_agenda);
const textoAgenda = cadena(s?.texto_agenda) || 'Agenda online';
const nota = cadena(s?.nota);
const boton = cadena(s?.boton) || 'Enviar solicitud';
const pasos = (s?.items ?? []).filter((i) => cadena(i.titulo));
const telefono = site.contacto.telefono;
const terapias = seccionDeTipo('terapias')?.terapias ?? [];
const servicios = terapias.map((t) => cadena(t.titulo)).filter(Boolean);
// «Ambas» = presencial y online; el resto, tal cual (sin repetir).
const modalidades = [...new Set(terapias.flatMap((t) => {
  const m = cadena(t.modalidad);
  return /^ambas$/i.test(m) ? ['Presencial', 'Online'] : m ? [m] : [];
}))];
---

{
  s && (
    <section id={Astro.props.id} class="mitades">
      <div class="mitad mitad--izq banda-salvia">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        {s.titulo && <h2 class="titulo-grande mt-4">{s.titulo}</h2>}
        {s.texto && <p class="mt-6 max-w-[34rem] text-lg opacity-90">{s.texto}</p>}
        {pasos.length > 0 && (
          <ol class="pasos-cita mt-10 max-w-[34rem]">
            {pasos.map((p) => (
              <li>
                <div>
                  <p class="font-display text-[1.35rem] leading-snug">{p.titulo}</p>
                  {cadena(p.texto) && <p class="text-[.95rem] opacity-85">{p.texto}</p>}
                </div>
              </li>
            ))}
          </ol>
        )}
        {(cta || agenda) && (
          <div class="mt-10 flex flex-wrap gap-3">
            {cta && <a class="btn btn-claro" href={cta.url} {...(externo(cta.url) && { rel: 'noopener', target: '_blank' })}>{cta.texto}</a>}
            {agenda && <a class="btn-sec" href={agenda} rel="noopener" target="_blank">{textoAgenda}</a>}
          </div>
        )}
        {telefono && (
          <p class="mt-8">
            <a class="inline-flex min-h-11 items-center gap-3 font-display text-[1.75rem] no-underline hover:underline" href={tel(telefono)}>
              <Icono nombre="telefono" tam={22} />
              {telefono}
            </a>
          </p>
        )}
        {nota && <p class="mt-6 max-w-[34rem] text-sm opacity-80">{nota}</p>}
      </div>
      <div class="mitad mitad--der banda-clara">
        <FormularioContacto prefijo="cita" boton={boton} servicios={servicios} modalidades={modalidades} franjas={true} asunto={`Primera cita · ${site.nombre}`} class="max-w-[38rem]" />
      </div>
    </section>
  )
}
