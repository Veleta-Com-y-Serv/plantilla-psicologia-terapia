---
// Cabecera fija a todo el ancho: marca (sol sobre el horizonte + nombre en serif), menú de texto (site.yaml → menu)
// y botón (site.yaml → boton_cabecera). Sólida en arena; transparente sobre la portada a sangre mientras no se
// hace scroll (el script de abajo; sin JavaScript se queda sólida). En móvil, menú plegable con <details>.
// Aspecto en src/styles/global.css (.cabecera--sereno).
import { site } from '../data/site';
import type { Enlace } from '../data/site';
interface Props { variante?: string; cta?: Enlace | null }
const { variante = 'sereno', cta = null } = Astro.props;
const boton = cta && cta.url && cta.texto ? cta : null;
---

<header class={`cabecera cabecera--${variante}`}>
  <div class="contenedor cabecera-fila">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      {
        site.logo ? (
          <img src={site.logo} alt={site.nombre} class="marca-logo" width="160" height="40" />
        ) : (
          <>
            <span class="marca-inicial" aria-hidden="true">
              <svg width="38" height="38" viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="17" r="8" fill="var(--c-acento)" />
                <path d="M4 26h32M9 31h22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </span>
            <span class="marca-nombre">{site.nombre}</span>
          </>
        )
      }
    </a>
    <nav class="cabecera-nav" aria-label="Menú principal">
      {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
    </nav>
    {boton && <a href={boton.url} class="btn cabecera-cta">{boton.texto}</a>}
    {
      (site.menu.length > 0 || boton) && (
        <details class="menu-movil">
          <summary aria-label="Abrir el menú">
            <span class="menu-movil-icono" aria-hidden="true" />
            <span>Menú</span>
          </summary>
          <nav class="menu-movil-panel" aria-label="Menú">
            {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
            {boton && <a href={boton.url} class="btn">{boton.texto}</a>}
          </nav>
        </details>
      )
    }
  </div>
</header>
<script is:inline>
  (function () {
    var cab = document.querySelector('.cabecera');
    if (!cab) return;
    cab.querySelectorAll('.menu-movil a').forEach(function (a) {
      a.addEventListener('click', function () { a.closest('details').open = false; });
    });
    function iniciar() {
      var hero = document.querySelector('main > .hero-sangre:first-child');
      if (!hero) return;
      var poner = function () { cab.classList.toggle('cabecera--transparente', window.scrollY < 40); };
      poner();
      window.addEventListener('scroll', poner, { passive: true });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
    else iniciar();
  })();
</script>
