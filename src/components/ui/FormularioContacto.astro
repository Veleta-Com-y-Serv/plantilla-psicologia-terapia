---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con todos los campos
// en el cuerpo del mensaje. Si no hay email, se queda como muestra y lo avisa.
// `servicios`: títulos de las terapias para el desplegable «Qué te interesa» (vacía = sin desplegable).
// `modalidades`: opciones de «Cómo prefieres la sesión» (p. ej. Presencial, Online; vacía = sin pregunta).
// `franjas`: true añade «Cuándo te viene mejor» (mañana / tarde). `prefijo`: para no repetir ids si hay dos.
// Para un envío real, cambia `action` por el de tu proveedor.
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; servicios?: string[]; modalidades?: string[]; franjas?: boolean; prefijo?: string }
const {
  boton = 'Enviar mensaje',
  class: clase = '',
  asunto = `Consulta desde la web de ${site.nombre}`,
  servicios = [],
  modalidades = [],
  franjas = false,
  prefijo = 'f',
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (c: string) => `${prefijo}-${c}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="campo">
      <label for={id('nombre')}>Nombre</label>
      <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for={id('contacto')}>Email o teléfono</label>
      <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
    </div>
  </div>
  {
    servicios.length > 0 && (
      <div class="campo">
        <label for={id('servicio')}>Qué te interesa</label>
        <select id={id('servicio')} name="servicio">
          <option value="">Aún no lo sé</option>
          {servicios.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
    )
  }
  {
    modalidades.length > 0 && (
      <fieldset>
        <legend>Cómo prefieres la sesión</legend>
        <div class="opciones">
          {[...modalidades, 'Me da igual'].map((m, i) => (
            <label class="opcion">
              <input type="radio" name="modalidad" value={m} checked={i === modalidades.length} />
              <span>{m}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }
  {
    franjas && (
      <fieldset>
        <legend>Cuándo te viene mejor</legend>
        <div class="opciones">
          {['Por la mañana', 'Por la tarde', 'Cualquier hora'].map((m, i) => (
            <label class="opcion">
              <input type="radio" name="franja" value={m} checked={i === 2} />
              <span>{m}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }
  <div class="campo">
    <label for={id('mensaje')}>Mensaje</label>
    <textarea id={id('mensaje')} name="mensaje" rows="4" required></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
